--- factorial of five ---

     0  push 5
     1  store 0
     2  push 1
     3  store 1
     4  load 0
     5  jz 15
     6  load 1
     7  load 0
     8  mul
     9  store 1
    10  load 0
    11  push 1
    12  sub
    13  store 0
    14  jmp 4
    15  load 1
    16  halt

   step   1  push 5  ->  [5]
   step   2  store 0  ->  []
   step   3  push 1  ->  [1]
   step   4  store 1  ->  []
   step   5  load 0  ->  [5]
   step   6  jz 15  ->  []
   step   7  load 1  ->  [1]
   step   8  load 0  ->  [1 5]
   step   9  mul  ->  [5]
   step  10  store 1  ->  []
   step  11  load 0  ->  [5]
   step  12  push 1  ->  [5 1]
   step  13  sub  ->  [4]
   step  14  store 0  ->  []
   step  15  jmp 4  ->  []
   step  16  load 0  ->  [4]

   result 120 after 63 steps

